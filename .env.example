# Public URL of this app (used for MCP setup, tracked links and webhook URLs shown in Settings)
APP_URL=http://localhost:3000

# Scrape Creators platform key, shared by all workspaces (each is metered per day)
SCRAPECREATORS_API_KEY=
SCRAPECREATORS_DAILY_LIMIT_PER_WORKSPACE=100

# SQLite file. On Railway point this at the mounted volume, e.g. /data/contentstudio.db
# DATABASE_PATH=./data/contentstudio.db

# Demo login (demo@contentstudio.dev / demo-password) with sample data.
# Defaults to on outside production, off in production.
# SEED_DEMO_DATA=true

# Per-workspace keys and webhook secrets (MCP/API key, ManyChat, Stripe) are
# created in the app under Settings, not here.
