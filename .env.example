# Public URL of this app (used in Claude briefs and tracked link previews)
APP_URL=http://localhost:3000

# Bearer token for /api/ingest/* and /api/sync/* (Claude Code, scrapers, cron)
CONTENTSTUDIO_API_KEY=

# Discover
SCRAPECREATORS_API_KEY=

# Track
MANYCHAT_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=

# Storage (SQLite file). Set SEED_DEMO_DATA=false to start empty.
# DATABASE_PATH=./data/contentstudio.db
# SEED_DEMO_DATA=true
